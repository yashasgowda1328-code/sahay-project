# SAHAY Production Environment Variables
# Copy this file to .env and fill in real values before deployment.
# Do NOT commit .env to version control.

# Application
APP_NAME=SAHAY API
API_V1_PREFIX=/api/v1
DEBUG=False

# Database
POSTGRES_USER=sahay
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sahay
DATABASE_URL=postgresql+asyncpg://sahay:CHANGE_ME@db:5432/sahay

# CORS (comma-separated origins for production)
CORS_ORIGINS=https://sahay.example.com,https://counsellor.sahay.example.com

# Frontend API target (used by reverse proxy / nginx if needed)
VITE_API_URL=/api/v1
